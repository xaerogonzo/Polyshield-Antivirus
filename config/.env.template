# KicomAV config template — DO NOT edit this file directly.
# The installer (install.bat) generates config\.env from this template,
# substituting {PROJECT_ROOT} with the actual install path.
#
# If you need to manually create .env, copy this file to config\.env
# and replace {PROJECT_ROOT} with the full path to the project root
# (the folder containing launch_ui.vbs), e.g.:
#   SYSTEM_RULES_BASE=D:\MyProjects\KicomAI_Project\rules

SYSTEM_RULES_BASE={PROJECT_ROOT}\rules
USER_RULES_BASE={PROJECT_ROOT}\user_rules
KICOMAV_SUPPRESS_WARNINGS=1
