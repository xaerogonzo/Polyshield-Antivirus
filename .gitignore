# ── Python virtual environments ─────────────────────────────────────────────
# Rebuilt by install.bat (kicomav_env) and setup_guardian.bat (guardian_env)
kicomav_env/
guardian_env/

# ── External repo clones ─────────────────────────────────────────────────────
# Re-cloned by setup_guardian.bat
guardianai/

# ── Runtime / user data ──────────────────────────────────────────────────────
# These are generated at runtime and contain user-specific data
intelligence/
logs/
quarantine/
rules/
user_rules/
state/
telemetry/
# k2 manages this tree itself (see paths.k2_home())
k2/

# ── Machine-specific config ──────────────────────────────────────────────────
# Generated by install.bat with machine-specific paths
config/.env
# User preferences (saved by the app at runtime)
config/ui_settings.json
# k2 cache database (~200 MB) and SQLite WAL/SHM journal files
config/cache.db
config/cache.db-wal
config/cache.db-shm

# ── Python cache ─────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd

# ── Tokensave index ──────────────────────────────────────────────────────────
.tokensave/
# pyscope index -- generated, machine-local, same reasoning as .tokensave/
.pyscope/

# ── OS / editor junk ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# ── Windows Sandbox config (machine-specific paths)
# A .template file IS tracked; users copy it to PolyShield_Sandbox.wsb
# and fill in their own paths.
PolyShield_Sandbox.wsb

# ── AI assistant / workflow tooling (personal — not part of the project) ──
# Each contributor has their own preferences for how Claude Code / CodeGraph
# behave when working on this codebase. These files belong in personal local
# state, NOT in the shared repo.
CLAUDE.md
BASIC_INSTRUCTIONS.md
.codegraph/

# Added by TokenSave Manager
*.local.json
.claude/
*.onefile-build/
*.build/
dist/
build/
.venv/
venv/

# Build scripts are TRACKED: a release artifact that cannot be
# reproduced from the repository is not reproducible. The template
# versions were generated and ignored; the filled ones are source.
# Their OUTPUT is what gets ignored.
dist/
*.build/
*.dist/
*.onefile-build/

# UI capture output (goldens in tests/golden/ui are tracked)
artifacts/

# tokensave MCP binding (TokenSave Manager) — machine-local by choice
.mcp.json

# Settings cross-process lock sidecar (runtime artifact)
config/ui_settings.json.lock
config/*.corrupt

