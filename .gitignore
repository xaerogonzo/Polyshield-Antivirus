# ── Python virtual environments ─────────────────────────────────────────────
# Rebuilt by install.bat (kicomav_env) and setup_guardian.bat (guardian_env)
kicomav_env/
guardian_env/

# ── External repo clones ─────────────────────────────────────────────────────
# Re-cloned by setup_guardian.bat
guardianai/

# ── Runtime / user data ──────────────────────────────────────────────────────
# These are generated at runtime and contain user-specific data
intelligence/
logs/
quarantine/
rules/
user_rules/

# ── Machine-specific config ──────────────────────────────────────────────────
# Generated by install.bat with machine-specific paths
config/.env
# User preferences (saved by the app at runtime)
config/ui_settings.json
# k2 cache database (~200 MB)
config/cache.db

# ── Python cache ─────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd

# ── Tokensave index ──────────────────────────────────────────────────────────
.tokensave/

# ── OS / editor junk ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# Added by TokenSave Manager
*.local.json
.claude/
*.onefile-build/
*.build/
dist/
build/
.venv/
venv/
